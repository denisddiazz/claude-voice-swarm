# --- Claude Code ---
# Claude Code debe estar instalado y con sesión iniciada (ejecuta `claude` una vez).
CLAUDE_BIN=claude
# Modelo del subjefe (alias de Claude Code: haiku, sonnet, opus...)
SUBJEFE_MODEL=haiku
# Segundos máximos por turno
SUBJEFE_TIMEOUT=300
EMPRESA_TIMEOUT=3600
# Rutas: si son relativas se resuelven respecto a la carpeta del proyecto.
# Por defecto: empresas.json y datos/ junto a main.py.
# EMPRESAS_FILE=empresas.json
# DATA_DIR=datos

# --- Gasto (USD, según el total_cost_usd que declara Claude Code en cada turno) ---
# Valores iniciales arbitrarios: ajústalos a tu caso.
# Presupuesto por turno del subjefe (el de cada empresa va en empresas.json, obligatorio).
SUBJEFE_MAX_BUDGET_USD=0.5
# Tope diario global (suma de subjefe y empresas, día local). Al alcanzarlo, las órdenes
# quedan en cola hasta el día siguiente. 0 = sin tope (no recomendado).
TOPE_DIARIO_USD=10
# Encargos encadenados subjefe -> empresa -> subjefe sin un mensaje del jefe.
MAX_REBOTES=3
# Fallos seguidos de una sesión antes de recrearla (pierde su memoria; se avisa al subjefe).
SESION_MAX_FALLOS=3

# --- Entorno de las sesiones ---
# Las sesiones de Claude Code reciben solo una lista blanca de variables (PATH, HOME, LANG...).
# Añade aquí otras, separadas por comas (p. ej. SSH_AUTH_SOCK). Las definidas en este .env
# y las TELEGRAM_* / NTFY_* no pasan nunca.
ENTORNO_EXTRA=

# --- Telegram ---
TELEGRAM_TOKEN=123456789:ABCDEFxxxxxxxxxxxxxxxxxxxxxxx
# OBLIGATORIO. Si lo dejas en 0 el bot no obedece a nadie y te dice tu ID al escribirle.
AUTHORIZED_CHAT_ID=0

# --- ntfy (alertas urgentes al móvil) ---
NTFY_SERVER=https://ntfy.sh
# El tema funciona como contraseña: usa uno largo y aleatorio.
NTFY_TOPIC=cambia-esto-por-algo-aleatorio
NTFY_TOKEN=
# Minutos mínimos entre alertas urgentes
ALERTA_INTERVALO_MIN=10

# --- Voz local ---
KOKORO_VOICE=ef_dora
KOKORO_SPEED=1.05
WHISPER_MODEL_SIZE=small
