# --- Claude Code ---
# Claude Code debe estar instalado y con sesión iniciada (ejecuta `claude` una vez).
CLAUDE_BIN=claude
# Modelo del subjefe (alias de Claude Code: haiku, sonnet, opus...)
SUBJEFE_MODEL=haiku
# Segundos máximos por turno
SUBJEFE_TIMEOUT=300
EMPRESA_TIMEOUT=3600
EMPRESAS_FILE=empresas.json

# --- Telegram ---
TELEGRAM_TOKEN=123456789:ABCDEFxxxxxxxxxxxxxxxxxxxxxxx
# OBLIGATORIO. Si lo dejas en 0 el bot no obedece a nadie y te dice tu ID al escribirle.
AUTHORIZED_CHAT_ID=0

# --- ntfy (alertas urgentes al móvil) ---
NTFY_SERVER=https://ntfy.sh
# El tema funciona como contraseña: usa uno largo y aleatorio.
NTFY_TOPIC=cambia-esto-por-algo-aleatorio
NTFY_TOKEN=

# --- Voz local ---
KOKORO_VOICE=ef_dora
KOKORO_SPEED=1.05
WHISPER_MODEL_SIZE=small
