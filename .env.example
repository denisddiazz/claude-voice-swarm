# --- Claude (Anthropic) ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx
CLAUDE_FRONTAL_MODEL=claude-haiku-5-5
CLAUDE_DIRECTOR_MODEL=claude-sonnet-5-5
# Reintenta en otro modelo si Sonnet rechaza la petición (solo API de Claude directa). 1 = activado
DIRECTOR_FALLBACKS=1

# --- Telegram ---
TELEGRAM_TOKEN=123456789:ABCDEFxxxxxxxxxxxxxxxxxxxxxxx
# OBLIGATORIO. Si lo dejas en 0 el bot no obedece a nadie y te dice tu ID al escribirle.
AUTHORIZED_CHAT_ID=0

# --- ntfy (alertas críticas al móvil) ---
NTFY_SERVER=https://ntfy.sh
# El tema funciona como contraseña: usa uno largo y aleatorio.
NTFY_TOPIC=cambia-esto-por-algo-aleatorio
# Solo si usas un servidor ntfy con autenticación
NTFY_TOKEN=

# --- Herramientas del Director ---
# Carpeta sobre la que el Director puede leer archivos y ejecutar comandos
WORKDIR=.
# Comandos permitidos (prefijos separados por ';'). Solo lectura por defecto.
ALLOWED_COMMANDS=git status;git log;git diff;git branch;df;free;uptime;ls;ps;systemctl status;systemctl --failed;journalctl;docker ps;docker logs

# --- Voz local ---
KOKORO_VOICE=ef_dora
KOKORO_SPEED=1.05
WHISPER_MODEL_SIZE=small
